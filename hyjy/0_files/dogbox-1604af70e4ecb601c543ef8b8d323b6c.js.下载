(function () {
    var dogbox, opt = {delay: 200, minRatio: 0.5, maxRatio: 5, titleHeight: 20, scaleStep: 0.1},
        _oR = 1,
        _maxR = opt.maxRatio,
        _minR = opt.minRatio,
        moduleName = 'dogbox',
        body = document.body,
        tpl = (clazz, type) => {
            let elem = document.createElement(type || 'div')
            elem.classList.add('dogbox-' + clazz)
            return elem
        },
        mask = tpl('mask'),
        closeBtn = tpl('close-btn'),
        box = tpl('box'),
        content = tpl('content'),
        title = tpl('title');
    
    function render(obj) {
        content = tpl('content');
        title = tpl('title');
        
        box = tpl('box');
        box.style.display = 'none';
        
        mask = tpl('mask');
        mask.style.display = 'none';
        
        
        dogbox.ratio = 1;
        
        var inner = obj._boxInner;
        
        content.style.overflow = 'hidden';
        content.style.opacity = 0;
        
        dogbox.cow = 0;
        dogbox.coh = 0;
        
        if (typeof opt.targetWash === 'function') {
            obj = opt.targetWash(obj);
            if (!obj) return;
        }
        
        if (obj.nodeName.toUpperCase() === 'IMG') {
            dogbox.cow = obj.naturalWidth;
            dogbox.coh = obj.naturalHeight;
            content.appendChild(inner);
            
            // 标题
            if (obj.getAttribute('title')) {
                title.textContent = obj.getAttribute('title')
            }
        }
        else if(obj.nodeName.toUpperCase() === 'SVG') {
            content.appendChild(inner);
            dogbox.cow = parseFloat(inner.viewBox.baseVal.width);
            dogbox.coh = parseFloat(inner.viewBox.baseVal.height);
        }
        box.appendChild(content);
        //content.appendTo(box);
        
        [mask, closeBtn].forEach(elem => {
            elem.off('click')
            elem.on('click', close)
        })
        
        box.appendChild(title);
        
        body.appendChild(mask);
        body.appendChild(closeBtn);
        body.appendChild(box);
        
        
        // 处理 box 宽高位置
        dogbox.cow = dogbox.cow || content.scrollWidth;
        dogbox.coh = dogbox.coh || content.scrollHeight;
        dogbox.offsetX = 0;
        dogbox.offsetY = 0;
