                        var changed = !1, newRatio = dogbox.ratio;
                        var changedDistance = Math.abs(distance -  pr.distance)
                        if (changedDistance > 1) 
                        {
                            
                            if (distance > pr.distance) {
                                title.textContent = 'zoom out'
                                newRatio += opt.scaleStep;
                                newRatio = parseFloat(Math.min(newRatio, _maxR).toFixed(1));
                                changed = newRatio != dogbox.ratio;
                            }
                            else if (distance < pr.distance) {
                                title.textContent = 'zoom in'
                                newRatio -= opt.scaleStep;
                                newRatio = parseFloat(Math.max(newRatio, _minR).toFixed(1));
                                changed = newRatio != dogbox.ratio;
                            }
                            if (changed) {
                                dogbox.ratio = newRatio;
                            }
                        }
                        dogbox.offsetX += centerX - pr.centerX;
                        dogbox.offsetY += centerY - pr.centerY;
                        resize();
                    }
                    }catch(e){title.textContent = e}
                    pr = {centerX: centerX, centerY: centerY, distance: distance}
                }
                //return false;
            }
            
            box.on('mousemove', mouseMoveHandler);
            box.on('touchmove', touchMoveHandler);
        }
        
        box.on('mousedown touchstart', mouseDownHandler);
        box.on('mouseup touchend', function (e) {
            box.off('mousemove');
            if (e.touches && e.touches.length <= 1) {
                box.off('touchmove');
            }
        });
        box.on('dblclick', function () {
            dogbox.ratio = _oR;
            dogbox.offsetX = 0;
            dogbox.offsetY = 0;
            resize(false, true);
        });
        
        let dogboxEscHandler;
        dogboxEscHandler = function (e) {
            if (e.keyCode == 27) {
                close();
                window.removeEventListener('keydown', dogboxEscHandler)
            }
        }
        window.addEventListener('keydown', dogboxEscHandler)
        
        content.style.overflow = 'visible'
        content.style.opacity = 1
        
        dogbox = Doghole.Utils.extend(dogbox, {
            mask: mask,
            box: box,
            closeBtn: closeBtn,
            content: content
        });
        
        Doghole.Animate.stop(mask)
        Doghole.Animate.stop(box)
        mask.style.opacity = box.style.opacity = 0
        mask.style.display = box.style.display = 'block'
        Doghole.Animate.fadeIn(mask, opt.delay)
        Doghole.Animate.fadeIn(box, opt.delay)
        
        if (typeof opt.rendered === 'function') {
            opt.rendered(dogbox);
        }
    }
    
    function resize(init, delay) {
        // 重新计算居中位置
        if (init && (window.innerWidth < dogbox.cow || window.innerHeight < dogbox.coh + opt.titleHeight)) {
            if (window.innerWidth < dogbox.cow) {
                dogbox.ratio = (window.innerWidth - 20) / dogbox.cow;
                _maxR = dogbox.ratio * opt.maxRatio;
                _minR = dogbox.ratio * opt.minRatio;
                _oR = dogbox.ratio;
            }
            if (window.innerHeight < dogbox.coh * dogbox.ratio + opt.titleHeight) {
                dogbox.ratio = (window.innerHeight - opt.titleHeight - 20) / dogbox.coh / dogbox.ratio;
                _maxR = dogbox.ratio * opt.maxRatio;
                _minR = dogbox.ratio * opt.minRatio;
                _oR = dogbox.ratio;
            }
        }
        
        dogbox.left = (window.innerWidth - dogbox.cow * dogbox.ratio) / 2 + dogbox.offsetX,
        dogbox.top = (window.innerHeight - dogbox.coh * dogbox.ratio - opt.titleHeight) / 2 + dogbox.offsetY;
        dogbox.width = dogbox.cow * dogbox.ratio;
        dogbox.height = dogbox.coh * dogbox.ratio + opt.titleHeight;
        
        Doghole.Animate.stop(box)
        if (delay)
            Doghole.Animate.animate(box, {
                left: dogbox.left,
                top: dogbox.top,
                width: dogbox.width,
                height: dogbox.height
            }, opt.delay)
        else {
            box.style.left = dogbox.left + 'px'
            box.style.top = dogbox.top + 'px'
            box.style.width = dogbox.width + 'px'
            box.style.height = dogbox.height + 'px'
        }
    }
    
    function close() {
        if (typeof opt.beforeClose === 'function') {
            opt.beforeClose(dogbox);
        }
        box.off();
        mask.off();
        Doghole.Animate.fadeOut(box, opt.delay / 2, null, () => {
            box.remove()
            closeBtn.remove()
        })
        Doghole.Animate.fadeOut(mask, opt.delay, null, () => mask.remove())
        
        
        if (typeof opt.closed === 'function') {
            opt.closed(dogbox);
        }
    }
    
    function bindClick(obj) {
        obj.style.cursor = 'pointer';
        obj.on('click', () => {
            render(obj);
            return false;
        })
    }
    
    function preProcess(obj) {
        return new Promise((resolve, reject) => {
            if (obj.nodeName.toUpperCase() === 'IMG') {
                
                inner = document.createElement('img')
                inner.setAttribute('src', obj.getAttribute('src'))
                inner.setAttribute('width', '100%')
                
                inner.style.width = '100%';
                inner.style.height = '100%'
            }
            else if(obj.nodeName.toUpperCase() === 'SVG') {
                inner = document.createElement('div')
                inner.innerHTML = obj.outerHTML;
                inner = inner.firstElementChild;
                inner.style.maxWidth = 'none'
            }
            else {
                reject(false);
            }
            obj._boxInner = inner;
            resolve(obj);
        })
    }
    
    Element.prototype.dogbox = dogbox = function(options) {
        opt = Doghole.Utils.extend(opt, options);
        let v;
        if (typeof options.targetWash === 'function') {
            v = options.targetWash(this);
            if (!v) return true;
        }
        preProcess(v).then(v => bindClick(v));
    }
    
    
}());
}

