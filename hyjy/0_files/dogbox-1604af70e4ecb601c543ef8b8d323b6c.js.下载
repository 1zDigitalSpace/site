                newRatio = parseFloat(Math.max(newRatio, _minR).toFixed(1));
                changed = newRatio != dogbox.ratio;
            }
            else if (deltaY < 0) {
                newRatio += opt.scaleStep;
                newRatio = parseFloat(Math.min(newRatio, _maxR).toFixed(1));
                changed = newRatio != dogbox.ratio;
            }
            if (changed) {
                dogbox.ratio = newRatio;
                resize(!1, !0);
            }
            return false;
        });
        
        var pm = null, pr = null, rFlag = false;
        var mouseMoveHandler;
        var touchMoveHandler;
        var mouseDownHandler = function (e) {
            e.preventDefault();
            e.stopPropagation();
            
            if (e.type === 'touchstart' && pm && pm.type === 'touchstart' 
                && e.touches.length == 1
                && pm.touches.length == 1) {
                // 移动端双击事件判断
                let timespan = e.timeStamp - pm.timeStamp,
                distance = Math.max(Math.abs(e.pageX - pm.pageX), Math.abs(e.pageY - pm.pageY));
                
                if (timespan < 200) {
                    Doghole.Events.trigger(box, 'dblclick')
                    return !1
                }
            }
            
            pm = e;
            
            mouseMoveHandler = function (f) {
                f.preventDefault();
                f.stopPropagation();
                dogbox.offsetX += f.clientX - pm.clientX;
                dogbox.offsetY += f.clientY - pm.clientY;
                resize();
                pm = f;
                return false;
            }
            touchMoveHandler = function (f) {
                //f.preventDefault();
                //f.stopPropagation();
                if (f.touches.length == 1) {
                    // move
                    dogbox.offsetX += f.changedTouches[0].clientX - pm.changedTouches[0].clientX;
                    dogbox.offsetY += f.changedTouches[0].clientY - pm.changedTouches[0].clientY;
                    resize();
                    pm = f;
                }
                else if (f.touches.length >= 2) {
                    var centerX = 0;
                    var centerY = 0;
                    for (var i = 0; i < f.touches.length; i++) {
                        centerX += f.touches[i].clientX;
                        centerY += f.touches[i].clientY;
                    }
                    centerX /= f.touches.length;
                    centerY /= f.touches.length;
                    
                    // 计算触摸点到中心位置的距离的平均值
                    var totalDistance = 0;
                    for (var i = 0; i < f.touches.length; i++) {
                        var distanceX = f.touches[i].clientX - centerX;
                        var distanceY = f.touches[i].clientY - centerY;
                        totalDistance += Math.sqrt(distanceX * distanceX + distanceY * distanceY);
                    }
                    var distance = totalDistance / f.touches.length;
                    try {
